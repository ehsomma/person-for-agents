<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- 
    Esto lo agregue a mano para poder hacer una librería de clases y que tenga Microsoft.AspNetCore.App.
    La otra opción es hacer un proyecto de API y borrar todo.
    Microsoft.AspNetCore.App no se instala como paquete de Nugget.
    -->
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\Records.Shared.Http.Entities\Records.Shared.Http.Entities.csproj" />
    </ItemGroup>
</Project>
